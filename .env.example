# Plantilla de variables de entorno. Copiar a .env y rellenar.
# El .env real NUNCA se sube al repositorio (está en .gitignore).

# Puerto de uvicorn.
# OJO: en local, el microservicio de IA ya ocupa el 8000. Si esta API también
# arranca en 8000, IA_SERVICE_URL apuntaría a sí misma.
PORT=8001

# Secreto de firma de los JWT. El mismo que el backend Java si se quiere
# que los tokens emitidos por uno valgan en el otro.
JWT_SECRET=

# Conexión a MySQL, por piezas. core/config.py compone con ellas la URL de
# SQLAlchemy: mysql+aiomysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME
#
# Se guardan por separado, y no como una URL entera, por dos motivos:
#   1. Cada secreto se rota por su cuenta y es su propio secret en GitHub Actions.
#   2. Una contraseña con @ / : o # rompe la URL si no va percent-encoded;
#      componiéndola en código, se escapa una sola vez y de forma fiable.
#
# El backend Java usa el formato JDBC (jdbc:mysql://host:puerto/bd), que no
# sirve aquí. Mismos datos, distinta sintaxis.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Aiven exige TLS. No se pone en la URL: va en connect_args del engine,
# en core/database.py.
#
# Ruta del certificado de la CA de Aiven, descargado de su consola. Aiven firma
# el certificado del servidor con una CA propia que no está en el almacén de
# confianza del sistema: sin este fichero el handshake falla con
# "CERTIFICATE_VERIFY_FAILED: self-signed certificate in certificate chain".
# Es el truststore de Java.
#
# NO es un secreto (es el certificado público de la CA): viaja en el
# repositorio. Esta variable es opcional -- por defecto ca.pem en la raíz del
# proyecto -- y sólo hace falta tocarla si el fichero cambia de sitio.
# Una ruta relativa se resuelve contra la raíz del proyecto, no contra el
# directorio desde el que arranques uvicorn.
# AIVEN_CA_PATH=ca.pem

# Microservicio de IA (se autentica con la cabecera x-api-key).
# En local: http://localhost:8000
# En el VPS: http://fp_gpt:8000 — nombre del contenedor en la red Docker
IA_SERVICE_URL=
IA_SERVICE_API_KEY=

ENVIRONMENT=dev
