# Plantilla de variables de entorno. Copiar a .env y rellenar.
# El .env real NUNCA se sube al repositorio (está en .gitignore).

PORT=8000

# Secreto de firma de los JWT. El mismo que el backend Java si se quiere
# que los tokens emitidos por uno valgan en el otro.
JWT_SECRET=

# OJO: formato SQLAlchemy, no JDBC.
#   Java   -> jdbc:mysql://host:puerto/bd
#   Python -> mysql+aiomysql://usuario:clave@host:puerto/bd
# Aiven exige SSL; se pasa aparte en connect_args del engine.
DB_URL=
DB_USER=
DB_PASSWORD=

# Microservicio de IA (cabecera x-api-key)
IA_SERVICE_URL=
IA_SERVICE_API_KEY=

ENVIRONMENT=dev
